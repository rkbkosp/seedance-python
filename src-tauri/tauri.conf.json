{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seedance Studio",
  "version": "0.1.0",
  "identifier": "com.seedance.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seedance Studio",
        "width": 1460,
        "height": 980,
        "minWidth": 1160,
        "minHeight": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}

